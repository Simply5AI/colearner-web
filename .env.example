# Feature Flags
NEXT_PUBLIC_ENABLE_NCU=true
NEXT_PUBLIC_ENABLE_EXTRACTION=true

# Google Recaptcha v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
