# Auth.js v5
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
AUTH_GOOGLE_ID=<staging-google-client-id>
AUTH_GOOGLE_SECRET=<staging-google-client-secret>

# API (replace with your Railway staging API URL)
NEXT_PUBLIC_API_URL=https://<railway-api-staging-url>.up.railway.app
NEXT_PUBLIC_WS_URL=wss://<railway-api-staging-url>.up.railway.app

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_NCU=true
NEXT_PUBLIC_ENABLE_EXTRACTION=true

# Google Recaptcha v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le_V4YsAAAAADKcNwZfnOHiYJxytBLmWXKtMK5U
